---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localBusiness } from '../data/schema.mjs';
// Кириллица Cormorant 400 и 400 italic — ими набраны название на обложке и заголовки страниц над сгибом.
// ?url даёт тот же файл, что и CSS @fontsource, поэтому повторной загрузки нет.
import serifCyr from '@fontsource/cormorant-garamond/files/cormorant-garamond-cyrillic-400-normal.woff2?url';
import serifCyrItalic from '@fontsource/cormorant-garamond/files/cormorant-garamond-cyrillic-400-italic.woff2?url';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Шапка прозрачна над полноэкранной обложкой (только главная) */
  overlay?: boolean;
}
const { title, description, jsonLd = [], noindex = false, ogType = 'website', overlay = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const schema = [localBusiness(), ...jsonLd];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#123B2E" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={serifCyr} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifCyrItalic} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Текстиль Дизайн" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Текстиль Дизайн — студия текстильного оформления интерьеров" />
    <meta name="twitter:card" content="summary_large_image" />

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Перейти к содержимому</a>
    <Header overlay={overlay} />
    <!-- Колонтитул: номер и название текущей рубрики, только на широких экранах -->
    <p class="folio" aria-hidden="true"><span class="folio__num tnum"></span><span class="folio__name"></span></p>
    <main id="main" class={overlay ? undefined : 'page'}>
      <slot />
    </main>
    <Footer />
    <script>
      const num = document.querySelector('.folio__num')!, name = document.querySelector('.folio__name')!;
      const sections = document.querySelectorAll<HTMLElement>('[data-folio]');
      if (!sections.length) document.querySelector('.folio')!.remove();
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) {
          num.textContent = (e.target as HTMLElement).dataset.folio!;
          name.textContent = (e.target as HTMLElement).dataset.name!;
        }
      }), { rootMargin: '-50% 0px -50% 0px' });
      sections.forEach((s) => io.observe(s));
    </script>
  </body>
</html>
