---
// Шапка «Выпуска». На главной (overlay) прозрачна над обложкой, на остальных страницах — молочная.
import { salon } from '../data/site.mjs';
import { getWorks } from '../data/works';

interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const main = salon.phones[0];
const hasWorks = (await getWorks()).length > 0;
const here = Astro.url.pathname;

const nav = [
  { href: '/katalog/', label: 'Каталог', num: '02' },
  { href: '/uslugi/', label: 'Услуги', num: '04' },
  ...(hasWorks ? [{ href: '/nashi-raboty/', label: 'Работы', num: '06' }] : []),
  { href: '/#intro', label: 'О салоне', num: '01' },
  { href: '/kontakty/', label: 'Контакты', num: '05' },
];
const current = (href: string) => (href !== '/#intro' && here.startsWith(href) ? 'page' : undefined);
const hours = `${salon.hours.opens.replace(':00', '')}–${salon.hours.closes.replace(':00', '')}`;
---
<header class="hdr" data-state={overlay ? 'over' : 'solid'} data-overlay={overlay ? '' : undefined}>
  <a class="hdr__logo" href="/" aria-label={`${salon.name} — на главную`}>
    <img class="hdr__mono hdr__mono--light" src="/brand/monogram-ivory.svg" alt="" width="40" height="36">
    <img class="hdr__mono hdr__mono--dark" src="/brand/monogram-emerald.svg" alt="" width="40" height="36">
    <span class="hdr__word">{salon.name}</span>
  </a>
  <nav class="hdr__nav" aria-label="Основная навигация">
    {nav.map((n) => <a href={n.href} aria-current={current(n.href)}>{n.label}</a>)}
  </nav>
  <div class="hdr__aside">
    <span class="hdr__hours">Ежедневно {hours}</span>
    <a class="pill pill--champagne" href={`tel:${main.tel}`}><span class="tnum">{main.display}</span></a>
    <a class="icon-btn hdr__call" href={`tel:${main.tel}`} aria-label="Позвонить в салон">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
    </a>
    <button class="icon-btn hdr__burger" type="button" aria-label="Открыть меню" aria-haspopup="dialog" data-open-menu>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
    </button>
  </div>
</header>

<dialog class="menu" aria-label="Меню">
  <div class="menu__top">
    <span class="menu__word">{salon.name}</span>
    <button class="icon-btn" type="button" aria-label="Закрыть меню" data-close-menu autofocus>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <nav class="menu__nav" aria-label="Меню">
    {nav.map((n) => <a href={n.href} data-close-menu aria-current={current(n.href)}><span class="tnum">{n.num}</span>{n.label}</a>)}
  </nav>
  <div class="menu__contacts">
    <p>{salon.address.city}, {salon.address.street} · {salon.hours.text.toLowerCase()}</p>
    {salon.phones.map((p, i) => (
      <a href={`tel:${p.tel}`} class="tnum">{p.display} <small>{i === 0 ? 'салон' : p.label}</small></a>
    ))}
    <div class="menu__actions">
      <a class="btn btn--emerald" href={`tel:${main.tel}`}>Позвонить</a>
      <a class="btn btn--line" href={salon.maps.route} target="_blank" rel="noopener">Маршрут</a>
    </div>
  </div>
</dialog>

<script>
  const hdr = document.querySelector<HTMLElement>('.hdr')!;
  if (hdr.hasAttribute('data-overlay')) {
    const sync = () => { hdr.dataset.state = scrollY < 40 ? 'over' : 'solid'; };
    addEventListener('scroll', sync, { passive: true });
    sync();
  }
  const menu = document.querySelector<HTMLDialogElement>('.menu')!;
  document.querySelector('[data-open-menu]')!.addEventListener('click', () => menu.showModal());
  menu.querySelectorAll('[data-close-menu]').forEach((el) => el.addEventListener('click', () => menu.close()));
</script>
