---
// Фото по пути из контента ("/src/assets/media/intro.jpg", "/src/assets/works/…").
// Если файл есть — Astro делает AVIF/WebP нужных размеров; если нет — временная заглушка.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { placeholders, placeholderUrl } from '../data/media.mjs';

interface Props {
  src: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  /** Пропорции для заглушки, например 4/5 → [4, 5] */
  ratio?: [number, number];
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'auto';
}
const { src, alt, widths = [480, 800, 1200, 1600], sizes = '100vw', class: cls, ratio, loading = 'lazy', fetchpriority } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const file = files[src]?.default;
const name = src.split('/').pop() ?? '';
const w = Math.max(...widths);
const fallback = !file && placeholders[name] ? placeholderUrl(name, w, ratio ? Math.round((w * ratio[1]) / ratio[0]) : undefined) : null;
---
{file ? (
  <Picture src={file} alt={alt} widths={widths.filter((x) => x <= file.width)} sizes={sizes} formats={['avif', 'webp']}
    class={cls} loading={loading} fetchpriority={fetchpriority} decoding="async" />
) : fallback ? (
  <img src={fallback} alt={alt} class={cls} loading={loading} fetchpriority={fetchpriority} decoding="async" data-placeholder />
) : (
  <div class={cls} role="img" aria-label={alt} style="background: var(--milk-deep)" data-placeholder></div>
)}
