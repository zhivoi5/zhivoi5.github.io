---
import Logo from './Logo.astro';
import { categories } from '../data/catalog.mjs';
import { salon } from '../data/site.mjs';
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo tone="gold" />
      <p class="small muted">Индивидуальный пошив штор, тюль, карнизы, жалюзи и домашний текстиль. Москва, Коммунарка.</p>
    </div>
    <nav aria-label="Каталог в подвале">
      <p class="site-footer__title">Каталог</p>
      <ul role="list">
        {categories.map((c) => <li><a href={c.path}>{c.title}</a></li>)}
        <li><a href="/karnizy/lift-sistemy/">Лифт-системы для штор</a></li>
      </ul>
    </nav>
    <div>
      <p class="site-footer__title">Контакты</p>
      <address>
        <ul role="list">
          {salon.phones.map((p) => (
            <li><a class="tnum" href={`tel:${p.tel}`}>{p.display}</a> <span class="muted small">— {p.label}</span></li>
          ))}
          <li><a href={`mailto:${salon.email}`}>{salon.email}</a></li>
          <li><a href={salon.maps.yandex} target="_blank" rel="noopener">{salon.address.city}, {salon.address.district}, {salon.address.street}</a></li>
          <li class="muted">{salon.hours.text}</li>
        </ul>
      </address>
    </div>
  </div>
  <div class="container site-footer__bottom small">
    <span>© {year} Текстиль Дизайн</span>
    <span class="muted">Иллюстрации на сайте — графика, а не фотографии выполненных заказов.</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--color-surface-darkest); border-top: 1px solid var(--color-hairline-gold); padding-block: var(--space-8) calc(var(--space-6) + var(--bar-space, 0px)); }
  .site-footer__grid { display: grid; gap: var(--space-7); }
  .site-footer__brand { display: grid; gap: var(--space-4); max-width: 22rem; align-content: start; }
  .site-footer__title { font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-on-dark); margin-bottom: var(--space-4); }
  .site-footer ul { display: grid; gap: 0.35rem; }
  .site-footer a { text-decoration: none; display: inline-block; padding-block: 0.3rem; }
  .site-footer a:hover { color: var(--color-accent-on-dark); }
  .site-footer address { font-style: normal; }
  .site-footer__bottom { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); justify-content: space-between; margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid var(--color-line-on-dark); }
  @media (min-width: 768px) { .site-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .site-footer__grid { grid-template-columns: 1.2fr 1fr 1.2fr; } }
</style>
