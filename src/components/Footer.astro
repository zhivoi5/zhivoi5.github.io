---
import { salon } from '../data/site.mjs';
---
<footer class="foot">
  <img src="/brand/monogram-gold.svg" alt="" width="44" height="40">
  <p>«{salon.name}» — салон штор и текстильного дизайна.</p>
  <p class="foot__note">Фотографии на сайте — иллюстрации интерьеров, а не выполненные заказы салона. Работы салона собраны в разделе «Наши работы».</p>
</footer>

<nav class="bar" aria-label="Быстрая связь">
  <a href={`tel:${salon.phones[0].tel}`}>Позвонить</a>
  <a href={salon.maps.route} target="_blank" rel="noopener">Маршрут</a>
</nav>

<script>
  // Нижняя панель связи: после первого экрана и не поверх блока контактов
  const bar = document.querySelector('.bar')!;
  const first = document.querySelector('main > :first-child');
  const contacts = document.querySelector('[data-hide-bar]');
  let pastFirst = false, onContacts = false;
  const sync = () => bar.classList.toggle('is-on', pastFirst && !onContacts);
  if (first) new IntersectionObserver(([e]) => { pastFirst = !e.isIntersecting; sync(); }, { rootMargin: '-72px 0px 0px 0px' }).observe(first);
  if (contacts) new IntersectionObserver(([e]) => { onContacts = e.isIntersecting; sync(); }).observe(contacts);
</script>
