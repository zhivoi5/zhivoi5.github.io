---
// Блок контактов: только реальные способы связи — телефон, почта, маршрут на карте.
import Icon from './Icon.astro';
import { salon } from '../data/site.mjs';
interface Props { headingLevel?: 'h2' | 'h1'; title?: string; id?: string }
const { headingLevel = 'h2', title = 'Приходите в салон или позвоните', id = 'kontakty' } = Astro.props;
const H = headingLevel;
---
<section class="contacts section on-dark" id={id} aria-labelledby={`${id}-title`} data-hide-bar>
  <div class="container contacts__grid">
    <div class="contacts__head">
      <p class="label">Контакты</p>
      <H id={`${id}-title`} class="contacts__title">{title}</H>
      <p class="lead">Расскажите, какие окна нужно оформить, — дизайнер подскажет решение и договорится о выезде с образцами тканей.</p>
    </div>

    <div class="contacts__body">
      <ul role="list" class="contacts__phones">
        {salon.phones.map((p, i) => (
          <li>
            <a class:list={['contacts__phone', { 'is-main': i === 0 }]} href={`tel:${p.tel}`}>
              <Icon name="phone" />
              <span>
                <span class="contacts__number tnum">{p.display}</span>
                <span class="contacts__note">{p.label}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <dl class="contacts__list">
        <div>
          <dt><Icon name="pin" /> <span>Адрес</span></dt>
          <dd>
            <address>{salon.address.city}, {salon.address.okrug},<br />{salon.address.district}, {salon.address.street}</address>
            <span class="contacts__maps">
              <a class="link" href={salon.maps.yandex} target="_blank" rel="noopener">Яндекс Карты <Icon name="arrow" /></a>
              <a class="link" href={salon.maps.google} target="_blank" rel="noopener">Google Maps <Icon name="arrow" /></a>
            </span>
          </dd>
        </div>
        <div>
          <dt><Icon name="clock" /> <span>График работы</span></dt>
          <dd>{salon.hours.text}</dd>
        </div>
        <div>
          <dt><Icon name="mail" /> <span>Почта</span></dt>
          <dd><a href={`mailto:${salon.email}`}>{salon.email}</a></dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .contacts { background: var(--color-surface-dark); }
  .contacts__grid { display: grid; gap: var(--space-7); }
  .contacts__head { display: grid; gap: var(--space-4); align-content: start; }
  .contacts__title { font-size: var(--fs-h2); }
  .contacts__body { display: grid; gap: var(--space-6); }
  .contacts__phones { display: grid; gap: var(--space-3); }
  .contacts__phone {
    display: flex; gap: var(--space-4); align-items: center;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-line-on-dark); border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color var(--dur-fast), border-color var(--dur-fast);
  }
  .contacts__phone:hover { background: rgb(245 241 233 / 0.05); border-color: var(--color-accent-on-dark); }
  .contacts__phone.is-main { background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); }
  .contacts__phone.is-main:hover { background: var(--color-accent-hover); }
  .contacts__phone > span { display: grid; }
  .contacts__phone svg { flex: none; color: var(--color-accent-on-dark); }
  .contacts__phone.is-main svg { color: inherit; }
  .contacts__number { font-size: 1.375rem; font-weight: 600; letter-spacing: 0.01em; }
  .contacts__note { font-size: var(--fs-small); opacity: 0.85; }
  .contacts__list { display: grid; gap: var(--space-5); }
  .contacts__list > div { display: grid; gap: var(--space-2); padding-top: var(--space-5); border-top: 1px solid var(--color-line-on-dark); }
  .contacts__list dt { display: flex; gap: var(--space-3); align-items: center; font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-on-dark); }
  .contacts__list dt svg { width: 1.125rem; height: 1.125rem; }
  .contacts__list dd { font-size: 1.0625rem; }
  .contacts__list address { font-style: normal; }
  .contacts__list dd a:not(.link) { text-decoration-color: var(--color-line-on-dark); text-underline-offset: 4px; }
  .contacts__maps { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-2); }
  @media (min-width: 1024px) {
    .contacts__grid { grid-template-columns: 5fr 7fr; gap: var(--space-9); }
    .contacts__body { grid-template-columns: 1fr 1fr; align-items: start; }
  }
</style>
