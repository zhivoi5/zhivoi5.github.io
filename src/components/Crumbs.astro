---
interface Props { trail: { name: string; path: string }[] }
const { trail } = Astro.props;
---
<nav class="crumbs" aria-label="Хлебные крошки">
  <ol role="list">
    {trail.map((t, i) => (
      <li>{i < trail.length - 1 ? <a href={t.path}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
    ))}
  </ol>
</nav>
