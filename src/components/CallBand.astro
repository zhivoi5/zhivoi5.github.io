---
// Полоса «обсудить заказ»: звонок в салон или дизайнеру. Без форм.
import Icon from './Icon.astro';
import { salon } from '../data/site.mjs';
interface Props { title?: string; text?: string }
const {
  title = 'Обсудим ваши окна',
  text = 'Позвоните в салон: подскажем по тканям и конструкциям и договоримся о выезде дизайнера с образцами.',
} = Astro.props;
---
<aside class="call-band" aria-label="Связаться с салоном">
  <div class="container call-band__inner">
    <div class="call-band__text">
      <p class="call-band__title display">{title}</p>
      <p class="muted">{text} <span class="tnum">{salon.hours.text.toLowerCase()}</span>.</p>
    </div>
    <div class="call-band__actions">
      {salon.phones.map((p, i) => (
        <a class:list={['btn', { 'btn--ghost': i > 0 }]} href={`tel:${p.tel}`}>
          <Icon name="phone" />
          <span class="tnum">{p.display}</span>
        </a>
      ))}
      <p class="call-band__labels small muted">{salon.phones.map((p) => `${p.display.slice(-9)} — ${p.label.toLowerCase()}`).join(' · ')}</p>
    </div>
  </div>
</aside>

<style>
  .call-band { padding-block: var(--space-8); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); background: var(--color-surface); }
  .call-band__inner { display: grid; gap: var(--space-6); align-items: center; }
  .call-band__text { display: grid; gap: var(--space-3); max-width: 38rem; }
  .call-band__title { font-size: var(--fs-h3); }
  .call-band__actions { display: grid; gap: var(--space-3); }
  .call-band__actions .btn { width: 100%; }
  .call-band__actions .btn--ghost { color: var(--color-primary); }
  @media (min-width: 768px) {
    .call-band__actions { grid-template-columns: auto auto; justify-content: start; }
    .call-band__actions .btn { width: auto; }
    .call-band__labels { grid-column: 1 / -1; }
  }
  @media (min-width: 1024px) {
    .call-band__inner { grid-template-columns: 1fr auto; }
    .call-band__actions { justify-content: end; }
    .call-band__labels { text-align: right; }
  }
</style>
