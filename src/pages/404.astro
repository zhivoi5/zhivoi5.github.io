---
import Base from '../layouts/Base.astro';
import Spread from '../components/Spread.astro';
import { categories } from '../data/catalog.mjs';
import { salon } from '../data/site.mjs';
---
<Base title="Страница не найдена | Текстиль Дизайн" description="Такой страницы на сайте салона штор «Текстиль Дизайн» нет." noindex>
  <Spread trail={[{ name: 'Главная', path: '/' }, { name: 'Страница не найдена', path: '/404/' }]} label="Ошибка 404" folio="404"
    title="Такой страницы" accent="нет" lead="Возможно, адрес изменился. Начните с главной или выберите раздел каталога.">
    <a class="btn btn--emerald" href="/">На главную</a>
    <a class="btn btn--line" href={`tel:${salon.phones[0].tel}`}>Позвонить в салон</a>
  </Spread>
  <section class="rubric" aria-labelledby="nf-title">
    <div class="rubric__head"><p class="label">Каталог</p><h2 id="nf-title">Разделы <i>салона</i></h2></div>
    <div class="rubric__body pointers">
      {categories.map((c) => <a href={c.path}>{c.title} <span aria-hidden="true">→</span></a>)}
      <a href="/kontakty/">Контакты <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
