---
// «Выезд дизайнера»: что происходит во время визита, как подготовиться, звонок салону или дизайнеру.
import Base from '../../layouts/Base.astro';
import Spread from '../../components/Spread.astro';
import Colophon from '../../components/Colophon.astro';
import { featurePages, categoryBySlug } from '../../data/catalog.mjs';
import { readJson } from '../../data/content.mjs';
import { salon } from '../../data/site.mjs';
import { breadcrumbs, abs, BUSINESS_ID } from '../../data/schema.mjs';

const page = featurePages.find((f: any) => f.path === '/uslugi/vyezd-dizajnera/');
const t = readJson('pages/vyezd.json');
const parent = categoryBySlug['uslugi'];
const [main, designer] = salon.phones;
const trail = [
  { name: 'Главная', path: '/' },
  { name: parent.title, path: parent.path },
  { name: page.title, path: page.path },
];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  serviceType: 'Выезд дизайнера на замер',
  description: page.seo.description,
  url: abs(page.path),
  provider: { '@id': BUSINESS_ID },
  areaServed: [{ '@type': 'Place', name: 'Коммунарка' }, { '@type': 'City', name: 'Москва' }],
};
---
<Base title={page.seo.title} description={page.seo.description} jsonLd={[breadcrumbs(trail), service]}>
  <Spread trail={trail} label="Услуги — Первый шаг" folio="00" title={t.hero.title} accent={t.hero.titleAccent} lead={t.hero.lead} image={t.hero.image} imageAlt={t.hero.imageAlt}>
    <a class="btn btn--emerald" href={`tel:${designer.tel}`}>Татьяна, дизайнер: <span class="tnum">{designer.display}</span></a>
  </Spread>

  <section class="rubric" data-folio="01" data-name="Визит" aria-labelledby="visit-title">
    <div class="rubric__head">
      <p class="label"><span class="tnum">01</span> — Во время визита</p>
      <h2 id="visit-title">Что делает <i>дизайнер</i></h2>
    </div>
    <ul class="rubric__body theses theses--stack" role="list">
      {t.visit.map((v: any) => <li><h3>{v.title}</h3><p>{v.text}</p></li>)}
    </ul>
  </section>

  <section class="rubric" data-folio="02" data-name="Подготовка" aria-labelledby="prep-title">
    <div class="rubric__head">
      <p class="label"><span class="tnum">02</span> — Перед визитом</p>
      <h2 id="prep-title">Как <i>подготовиться</i></h2>
    </div>
    <ol class="rubric__body numbered" role="list">
      {t.prepare.map((p: string, i: number) => <li><span class="tnum">{String(i + 1).padStart(2, '0')}</span><p>{p}</p></li>)}
    </ol>
  </section>

  <section class="call" aria-labelledby="call-title">
    <div>
      <h2 id="call-title">{t.cta.title}</h2>
      <p>{t.cta.text}</p>
    </div>
    <div class="call__actions">
      <a class="btn btn--emerald" href={`tel:${main.tel}`}>Салон: <span class="tnum">{main.display}</span></a>
      <a class="btn btn--line" href={`tel:${designer.tel}`}>Татьяна: <span class="tnum">{designer.display}</span></a>
    </div>
  </section>

  <Colophon map={false} />
</Base>
