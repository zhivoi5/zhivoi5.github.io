---
// Блэкаут и Dimout — подборка внутри «Штор на заказ»: сравнение двух светозащитных тканей.
import Base from '../../layouts/Base.astro';
import Spread from '../../components/Spread.astro';
import Colophon from '../../components/Colophon.astro';
import { featurePages, categoryBySlug } from '../../data/catalog.mjs';
import { readJson } from '../../data/content.mjs';
import { breadcrumbs, abs, BUSINESS_ID } from '../../data/schema.mjs';

const page = featurePages.find((f: any) => f.path === '/shtory-na-zakaz/blackout-i-dimout/');
const t = readJson('pages/blackout.json');
const parent = categoryBySlug['shtory-na-zakaz'];
const trail = [
  { name: 'Главная', path: '/' },
  { name: 'Каталог', path: '/katalog/' },
  { name: parent.title, path: parent.path },
  { name: page.title, path: page.path },
];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  serviceType: 'Пошив штор блэкаут и Dimout',
  description: page.seo.description,
  url: abs(page.path),
  provider: { '@id': BUSINESS_ID },
  areaServed: [{ '@type': 'Place', name: 'Коммунарка' }, { '@type': 'City', name: 'Москва' }],
};
---
<Base title={page.seo.title} description={page.seo.description} jsonLd={[breadcrumbs(trail), service]}>
  <Spread trail={trail} label={`${parent.title} — Светозащита`} folio="00" title="Блэкаут" accent="и Dimout" lead={t.lead} image={t.image} imageAlt={t.imageAlt} />

  <section class="rubric" data-folio="01" data-name="Сравнение" aria-labelledby="cmp-title">
    <div class="rubric__head">
      <p class="label"><span class="tnum">01</span> — Сравнение</p>
      <h2 id="cmp-title">Темнота <i>или полутень</i></h2>
    </div>
    <div class="rubric__body compare">
      <article>
        <p class="label">Blackout</p>
        <h3>{t.blackout.title}</h3>
        <ul role="list">{t.blackout.points.map((p: string) => <li>{p}</li>)}</ul>
      </article>
      <article>
        <p class="label">Dimout</p>
        <h3>{t.dimout.title}</h3>
        <ul role="list">{t.dimout.points.map((p: string) => <li>{p}</li>)}</ul>
      </article>
    </div>
  </section>

  <section class="rubric" data-folio="02" data-name="В каталоге" aria-labelledby="where-title">
    <div class="rubric__head">
      <p class="label"><span class="tnum">02</span> — В каталоге</p>
      <h2 id="where-title">Где <i>применяется</i></h2>
      <p class="rubric__note">Светонепроницаемые ткани используются не только в классических шторах.</p>
    </div>
    <div class="rubric__body pointers">
      {t.where.map((w: any) => <a href={w.href}>{w.name} <span aria-hidden="true">→</span></a>)}
    </div>
  </section>

  <Colophon map={false} />
</Base>
