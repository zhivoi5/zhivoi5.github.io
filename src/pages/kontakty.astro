---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Colophon from '../components/Colophon.astro';
import Terms from '../components/Terms.astro';
import { breadcrumbs } from '../data/schema.mjs';
import { salon } from '../data/site.mjs';

const trail = [{ name: 'Главная', path: '/' }, { name: 'Контакты', path: '/kontakty/' }];
---
<Base
  title="Контакты салона штор «Текстиль Дизайн» — Коммунарка, проспект Куприна, 11к2"
  description={`Салон штор «Текстиль Дизайн»: ${salon.address.city}, ${salon.address.district}, ${salon.address.street}. ${salon.hours.text}. Тел. ${salon.phones.map((p) => p.display).join(', ')}.`}
  jsonLd={[breadcrumbs(trail)]}
>
  <div class="kp-crumbs"><Crumbs trail={trail} /></div>
  <Colophon level="h1" />
  <div class="kp-terms"><Terms /></div>
</Base>

<style>
  .kp-crumbs { padding: 20px var(--gutter); }
  .kp-terms { padding: 48px var(--gutter) 96px; }
</style>
