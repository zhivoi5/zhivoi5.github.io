---
// Лифт-системы — подборка внутри «Карнизов и механизмов». Схема-анимация заменена кадром и текстом.
import Base from '../../layouts/Base.astro';
import Spread from '../../components/Spread.astro';
import Colophon from '../../components/Colophon.astro';
import { featurePages, categoryBySlug } from '../../data/catalog.mjs';
import { readJson } from '../../data/content.mjs';
import { salon } from '../../data/site.mjs';
import { breadcrumbs, abs, BUSINESS_ID } from '../../data/schema.mjs';

const page = featurePages.find((f: any) => f.path === '/karnizy/lift-sistemy/');
const t = readJson('pages/lift.json');
const parent = categoryBySlug['karnizy'];
const trail = [
  { name: 'Главная', path: '/' },
  { name: 'Каталог', path: '/katalog/' },
  { name: parent.title, path: parent.path },
  { name: page.title, path: page.path },
];
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  serviceType: 'Лифт-система для штор',
  description: page.seo.description,
  url: abs(page.path),
  provider: { '@id': BUSINESS_ID },
  areaServed: [{ '@type': 'Place', name: 'Коммунарка' }, { '@type': 'City', name: 'Москва' }],
};
const related = parent.groups.flatMap((g: any) => g.items).filter((i: any) => /электро|потолоч|монтаж|подсвет/i.test(i.name));
---
<Base title={page.seo.title} description={page.seo.description} jsonLd={[breadcrumbs(trail), service]}>
  <Spread trail={trail} label={`${parent.title} — Механизмы`} folio="00" title="Лифт-системы" accent="для штор" lead={t.lead} image={t.image} imageAlt={t.imageAlt}>
    <a class="btn btn--emerald" href={`tel:${salon.phones[0].tel}`}>Позвонить в салон</a>
  </Spread>

  <section class="rubric" data-folio="01" data-name="Как работает" aria-labelledby="how-title">
    <div class="rubric__head">
      <p class="label"><span class="tnum">01</span> — Как это работает</p>
      <h2 id="how-title">Три движения <i>вместо стремянки</i></h2>
      <p class="rubric__note">{t.note}</p>
    </div>
    <ol class="rubric__body numbered" role="list">
      {t.steps.map((s: any, i: number) => <li><span class="tnum">{String(i + 1).padStart(2, '0')}</span><b>{s.title}</b><p>{s.text}</p></li>)}
    </ol>
  </section>

  <section class="rubric" data-folio="02" data-name="Когда нужно" aria-labelledby="cases-title">
    <div class="rubric__head">
      <p class="label"><span class="tnum">02</span> — Когда это нужно</p>
      <h2 id="cases-title">Для окон, <i>до которых не добраться</i></h2>
    </div>
    <ul class="rubric__body theses theses--stack" role="list">
      {t.cases.map((c: any) => <li><h3>{c.title}</h3><p>{c.text}</p></li>)}
    </ul>
  </section>

  <section class="rubric" data-folio="03" data-name="Вместе" aria-labelledby="with-title">
    <div class="rubric__head">
      <p class="label"><span class="tnum">03</span> — Вместе с лифт-системой</p>
      <h2 id="with-title">Что ещё <i>подберёт салон</i></h2>
    </div>
    <div class="rubric__body pointers">
      {related.map((i: any) => <a href={`${parent.path}#${i.id}`}>{i.name} <span aria-hidden="true">→</span></a>)}
      <a href={parent.path}>Все карнизы и механизмы <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <Colophon map={false} />
</Base>
