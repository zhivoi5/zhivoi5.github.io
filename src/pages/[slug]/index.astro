---
// Раздел каталога в стиле «Выпуск»: разворот, группы-рубрики с позициями (якоря сохранены), подборка, соседние разделы.
// «Ткани» и «Услуги» — отдельные страницы со своей композицией.
import Base from '../../layouts/Base.astro';
import Spread from '../../components/Spread.astro';
import Entries from '../../components/Entries.astro';
import Band from '../../components/Band.astro';
import Colophon from '../../components/Colophon.astro';
import { categories } from '../../data/catalog.mjs';
import { readJson } from '../../data/content.mjs';
import { salon } from '../../data/site.mjs';
import { breadcrumbs, categoryService } from '../../data/schema.mjs';

export function getStaticPaths() {
  return categories
    .filter((c) => !['tkani', 'uslugi'].includes(c.slug))
    .map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}

const { cat } = Astro.props;
const code = `Т-${String(cat.order).padStart(2, '0')}`;
const trail = [
  { name: 'Главная', path: '/' },
  { name: 'Каталог', path: '/katalog/' },
  { name: cat.title, path: cat.path },
];
// Подборки внутри разделов — отдельные страницы с собственным смыслом запроса
const bands: Record<string, any> = {
  karnizy: { ...readJson('pages/lift.json'), label: 'Механизмы', title: 'Лифт-системы', accent: 'для высоких потолков', href: '/karnizy/lift-sistemy/', link: 'Как устроены лифт-системы', textKey: 'lead' },
  'shtory-na-zakaz': { ...readJson('pages/blackout.json'), label: 'Светозащита', title: 'Блэкаут', accent: 'и Dimout', href: '/shtory-na-zakaz/blackout-i-dimout/', link: 'Чем они отличаются', textKey: 'lead' },
};
const band = bands[cat.slug];
const i = categories.indexOf(cat);
const neighbours = [categories[i - 1], categories[i + 1]].filter(Boolean);
---
<Base title={cat.seo.title} description={cat.seo.description} jsonLd={[breadcrumbs(trail), categoryService(cat)]}>
  <Spread trail={trail} label={`${code} — Каталог`} folio={code} title={cat.title} lead={cat.intro} image={cat.image} imageAlt={cat.short}>
    <a class="btn btn--emerald" href={`tel:${salon.phones[0].tel}`}>Позвонить в салон</a>
    <a class="btn btn--line" href="/uslugi/vyezd-dizajnera/">Выезд дизайнера</a>
  </Spread>

  <Entries groups={cat.groups} section={cat.title} />

  {band && (
    <Band label={band.label} title={band.title} accent={band.accent} text={band[band.textKey]} href={band.href} link={band.link} image={band.image} imageAlt={band.imageAlt} />
  )}

  <section class="rubric" aria-labelledby="next-title">
    <div class="rubric__head">
      <p class="label">Каталог</p>
      <h2 id="next-title">Рядом <i>в каталоге</i></h2>
    </div>
    <div class="rubric__body pointers">
      {neighbours.map((n) => <a href={n.path}>{n.title} <span aria-hidden="true">→</span></a>)}
      <a href="/katalog/">Все разделы каталога <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <Colophon map={false} />
</Base>
