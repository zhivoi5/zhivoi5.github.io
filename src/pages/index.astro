---
// Главная «Выпуск» — перенос утверждённого прототипа (prototype/index.html) один в один.
// Тексты — src/content/pages/home.json, каталог и контакты — из общих данных.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Toc from '../components/Toc.astro';
import Steps from '../components/Steps.astro';
import Terms from '../components/Terms.astro';
import Colophon from '../components/Colophon.astro';
import { categories, categoryBySlug } from '../data/catalog.mjs';
import { readJson } from '../data/content.mjs';
import { salon } from '../data/site.mjs';

const t = readJson('pages/home.json');
const main = salon.phones[0];
const services = categoryBySlug['uslugi'];
const tkani = categoryBySlug['tkani'];
const tkaniNum = String(categories.indexOf(tkani) + 1).padStart(2, '0');
// Живые шторы: ролик подключается, только если файлы уже лежат в public/media/
const video = ['hero-loop.webm', 'hero-loop.mp4'].filter((f) => existsSync(join(process.cwd(), 'public', 'media', f)));
const accent = (text: string, word: string) => text.replace(word, `<i>${word}</i>`);
---
<Base title={t.seo.title} description={t.seo.description} overlay>

<!-- 00 — Обложка -->
<section class="cover" id="top" data-folio="00" data-name="Обложка" aria-labelledby="h1">
  <Photo class="cover__img" src={t.hero.image} alt={t.hero.imageAlt} widths={[900, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
  {video.length > 0 && (
    <video class="cover__video" muted loop playsinline preload="none" aria-hidden="true"
      data-src-webm={video.includes('hero-loop.webm') ? '/media/hero-loop.webm' : undefined}
      data-src-mp4={video.includes('hero-loop.mp4') ? '/media/hero-loop.mp4' : undefined}></video>
  )}
  <div class="cover__shade" aria-hidden="true"></div>
  {video.length > 0 && <button class="cover__pause" type="button" aria-pressed="false">Пауза</button>}

  <p class="cover__mast" aria-hidden="true"><span>Текстиль</span><span><i>Дизайн</i></span></p>

  <div class="cover__foot">
    <ul class="perks" role="list" aria-label="Преимущества салона">
      {t.hero.perks.map((p: { title: string; text: string }) => <li>{p.title}<small>{p.text}</small></li>)}
    </ul>
    <div class="cover__lead">
      <h1 id="h1">{t.hero.title}</h1>
      <p>{t.hero.lead}</p>
      <div class="cover__actions">
        <a class="btn btn--ivory" href={`tel:${main.tel}`}>Позвонить в салон</a>
        <a class="btn btn--ghost-light" href="#catalog">Каталог <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </div>
</section>

<!-- 01 — Вступление: кадр заходит на обложку и связывает экраны -->
<section class="intro" id="intro" data-folio="01" data-name="Вступление" aria-labelledby="intro-title">
  <figure class="intro__fig">
    <Photo src={t.intro.image} alt={t.intro.imageAlt} widths={[600, 900, 1200]} sizes="(min-width: 900px) 34vw, 78vw" ratio={[4, 5]} />
    {t.intro.caption && <figcaption>{t.intro.caption}</figcaption>}
  </figure>

  <div class="intro__text">
    <p class="label"><span class="tnum">01</span> — Вступление</p>
    <h2 id="intro-title" class="visually-hidden">О салоне</h2>
    <blockquote class="quote">
      <p set:html={accent(t.intro.quote, t.intro.quoteAccent)} />
    </blockquote>
    <p class="intro__body">{t.intro.body}</p>
  </div>
</section>

<!-- 02 — Каталог-оглавление -->
<section class="index" id="catalog" data-folio="02" data-name="Каталог" aria-labelledby="index-title">
  <header class="index__head">
    <p class="label"><span class="tnum">02</span> — Каталог</p>
    <h2 id="index-title">{t.catalog.title} <i>{t.catalog.titleAccent}</i></h2>
  </header>
  <Toc sections={categories} />
</section>

<!-- 03 — Материал: макро ткани во весь экран + «этикетка образца» -->
<section class="material" id="material" data-folio="03" data-name="Материал" aria-labelledby="material-title">
  <Photo class="material__img" src={t.material.image} alt={t.material.imageAlt} widths={[1000, 1600, 2400]} sizes="100vw" />
  <div class="material__shade" aria-hidden="true"></div>
  <div class="material__inner">
    <p class="label label--gold"><span class="tnum">03</span> — Материал</p>
    <h2 id="material-title" class="material__title">{t.material.title}<br><i>{t.material.titleAccent}</i></h2>
    <p class="material__body">{t.material.body}</p>
  </div>
  <aside class="swatch" aria-label={`Раздел каталога: ${tkani.title.toLowerCase()}`}>
    <p class="swatch__code tnum">Т-{tkaniNum}</p>
    <p class="swatch__title">{tkani.title}</p>
    <ul role="list">
      {tkani.groups.flatMap((g: any) => g.items).map((i: any) => <li>{i.name}</li>)}
    </ul>
    <a class="link" href={tkani.path}>Раздел «Ткани» <span aria-hidden="true">→</span></a>
  </aside>
</section>

<!-- 04 — Ателье: услуги, этапы и условия -->
<section class="atelier" id="services" data-folio="04" data-name="Ателье" aria-labelledby="atelier-title">
  <figure class="atelier__fig">
    <Photo src={t.atelier.image} alt={t.atelier.imageAlt} widths={[600, 900, 1200]} sizes="(min-width: 900px) 40vw, 100vw" ratio={[11, 14]} />
    {t.atelier.caption && <figcaption>{t.atelier.caption}</figcaption>}
  </figure>

  <div class="atelier__text">
    <p class="label"><span class="tnum">04</span> — Ателье</p>
    <h2 id="atelier-title">{t.atelier.title} <i>{t.atelier.titleAccent}</i></h2>

    <a class="feature" href="/uslugi/vyezd-dizajnera/">
      <span class="feature__kicker">Начните с этого</span>
      <span class="feature__title">Выезд дизайнера на замер</span>
      <span class="feature__text">{t.atelier.featureText}</span>
      <span class="feature__arrow" aria-hidden="true">→</span>
    </a>

    <dl class="groups">
      {services.groups.map((g: any) => (
        <div><dt>{g.title}</dt><dd>{g.items.map((i: any) => i.name).join(' · ')}</dd></div>
      ))}
    </dl>
    <a class="link" href={services.path}>Все услуги <span aria-hidden="true">→</span></a>
  </div>

  <Steps steps={t.atelier.steps} />
  <Terms />
</section>

<!-- 05 — Контакты и карта -->
<Colophon />

</Base>

<script>
  // Живые шторы: только широкий экран, без «уменьшить движение» и без экономии трафика.
  // На телефоне остаётся постер — он же первая отрисовка (LCP) на любом устройстве.
  const video = document.querySelector<HTMLVideoElement>('.cover__video');
  const pause = document.querySelector<HTMLButtonElement>('.cover__pause');
  const cover = document.querySelector('.cover')!;
  const wantsVideo = matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)').matches
    && !(navigator as any).connection?.saveData;
  if (video && pause && wantsVideo) {
    for (const [attr, type] of [['srcWebm', 'video/webm'], ['srcMp4', 'video/mp4']]) {
      if (!video.dataset[attr]) continue;
      const s = document.createElement('source');
      s.src = video.dataset[attr]!; s.type = type;
      video.append(s);
    }
    video.addEventListener('playing', () => { video.classList.add('is-playing'); pause.classList.add('is-on'); }, { once: true });
    video.load();
    // Не тратим ресурсы, когда обложка вне экрана
    new IntersectionObserver(([e]) => {
      if (pause.getAttribute('aria-pressed') === 'true') return;
      e.isIntersecting ? video.play().catch(() => {}) : video.pause();
    }).observe(cover);
    pause.addEventListener('click', () => {
      const paused = pause.getAttribute('aria-pressed') === 'true';
      pause.setAttribute('aria-pressed', String(!paused));
      pause.textContent = paused ? 'Пауза' : 'Продолжить';
      paused ? video.play() : video.pause();
    });
  }
</script>
